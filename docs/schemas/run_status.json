      "additionalProperties": false,
      "description": "One FedAvg (fed_linreg) or Newton-Raphson (fed_logreg) round.",
      "properties": {
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "sites": {
          "title": "Sites",
          "type": "integer"
        },
        "max_delta": {
          "title": "Max Delta",
          "type": "number"
        },
        "coef": {
          "additionalProperties": {
            "type": "number"
