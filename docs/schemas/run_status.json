  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "flagged",
        "rejected",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "submitted": {
      "title": "Submitted",
      "type": "string"
    },
    "finished": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished"
