        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "sites_expected": {
      "items": {
        "type": "string"
      },
      "title": "Sites Expected",
      "type": "array"
    },
    "sites_reported": {
      "items": {
        "type": "string"
      },
      "title": "Sites Reported",
      "type": "array"
    },
    "sites_missing": {
      "items": {
        "type": "string"
      },
      "title": "Sites Missing",
      "type": "array"
    },
    "sites_failed": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Sites Failed",
      "type": "object"
    },
    "coverage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleasedResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
